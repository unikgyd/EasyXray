<Window x:Class="EasyXray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:XrayDeploy.Core;assembly=XrayDeploy.Core"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="EasyXray" Height="820" Width="1120" MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline4TextBlock}"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#F4FAF5" /></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#9BE7AA"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/></Style>
        <Style x:Key="HintText" TargetType="TextBlock"><Setter Property="Foreground" Value="#C4D2C6"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="WideLeft" TargetType="FrameworkElement"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="0"/></Style>
        <Style x:Key="WideMiddle" TargetType="FrameworkElement"><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.Row" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="2"/><Setter Property="Margin" Value="0,18,0,0"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="WideRight" TargetType="FrameworkElement"><Setter Property="Grid.Column" Value="4"/><Setter Property="Grid.Row" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="4"/><Setter Property="Margin" Value="0,18,0,0"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="WideSecond" TargetType="FrameworkElement"><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.Row" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="2"/><Setter Property="Margin" Value="0,18,0,0"/></DataTrigger></Style.Triggers></Style>

        <DataTemplate DataType="{x:Type core:RealityInboundProfile}">
            <StackPanel Margin="18">
                <DockPanel><materialDesign:PackIcon Kind="ShieldLockOutline" Width="30" Height="30" Foreground="#78D98B"/><StackPanel Margin="12,0,0,0"><TextBlock Text="REALITY 入站" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="推荐 · TCP/443 · 无需域名" Style="{StaticResource HintText}"/></StackPanel></DockPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="名称" Margin="0,18,0,0"/>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox Text="{Binding DataContext.RealityTarget, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="伪装目标，例如 dl.google.com:443"/><TextBox Grid.Column="2" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="TCP 端口"/></Grid>
                <TextBox Text="{Binding DataContext.RealityServerName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Server Name / SNI" Margin="0,10,0,0"/>
                <Expander Header="高级参数（通常无需修改）" Margin="0,12,0,0"><StackPanel Margin="4,8,4,2"><TextBox Text="{Binding Users[0].Id, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="客户端 UUID"/><TextBox Text="{Binding DataContext.RealityShortId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Short ID" Margin="0,8,0,0"/><TextBox Text="{Binding DataContext.RealityPublicKey, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" IsReadOnly="True" materialDesign:HintAssist.Hint="REALITY 公钥（自动生成）" Margin="0,8,0,0"/></StackPanel></Expander>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:Hysteria2InboundProfile}">
            <StackPanel Margin="18">
                <DockPanel><materialDesign:PackIcon Kind="Speedometer" Width="30" Height="30" Foreground="#D5A83E"/><StackPanel Margin="12,0,0,0"><TextBlock Text="Hysteria2 入站" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="进阶 · UDP/443 · 必须拥有域名和可信 TLS 证书" Style="{StaticResource HintText}"/></StackPanel></DockPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="名称" Margin="0,18,0,0"/>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox Text="{Binding DataContext.CertificateDomain, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="证书域名"/><TextBox Grid.Column="2" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="UDP 端口"/></Grid>
                <TextBox Text="{Binding Users[0].Authentication, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="认证密码（自动生成）" Margin="0,10,0,0"/>
                <Expander Header="高级参数（通常无需修改）" Margin="0,12,0,0"><StackPanel Margin="4,8,4,2"><TextBox Text="{Binding Obfuscation, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="可选 Salamander 混淆密码"/><TextBox Text="{Binding TlsCertificatePath}" IsReadOnly="True" materialDesign:HintAssist.Hint="远程证书路径（Certbot 自动填写）" Margin="0,8,0,0"/></StackPanel></Expander>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:RealityOutboundProfile}"><StackPanel Margin="14"><TextBlock Text="REALITY 下一跳" FontSize="18" FontWeight="SemiBold"/><TextBox Text="{Binding Name}" materialDesign:HintAssist.Hint="名称" Margin="0,12,0,0"/><TextBox Text="{Binding ServerAddress}" materialDesign:HintAssist.Hint="服务器地址" Margin="0,8,0,0"/><TextBox Text="{Binding ServerPort}" materialDesign:HintAssist.Hint="端口" Margin="0,8,0,0"/><TextBox Text="{Binding ServerName}" materialDesign:HintAssist.Hint="SNI" Margin="0,8,0,0"/><TextBox Text="{Binding PublicKey}" materialDesign:HintAssist.Hint="对方 REALITY 公钥" Margin="0,8,0,0"/><TextBox Text="{Binding ShortId}" materialDesign:HintAssist.Hint="Short ID" Margin="0,8,0,0"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type core:Hysteria2OutboundProfile}"><StackPanel Margin="14"><TextBlock Text="Hysteria2 下一跳" FontSize="18" FontWeight="SemiBold"/><TextBox Text="{Binding Name}" materialDesign:HintAssist.Hint="名称" Margin="0,12,0,0"/><TextBox Text="{Binding ServerAddress}" materialDesign:HintAssist.Hint="服务器地址" Margin="0,8,0,0"/><TextBox Text="{Binding ServerPort}" materialDesign:HintAssist.Hint="端口" Margin="0,8,0,0"/><TextBox Text="{Binding Authentication}" materialDesign:HintAssist.Hint="认证密码" Margin="0,8,0,0"/><TextBox Text="{Binding TlsServerName}" materialDesign:HintAssist.Hint="证书域名 / SNI" Margin="0,8,0,0"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type core:WireGuardOutboundProfile}"><StackPanel Margin="14"><TextBlock Text="WireGuard 下一跳" FontSize="18" FontWeight="SemiBold"/><TextBox Text="{Binding Name}" materialDesign:HintAssist.Hint="名称" Margin="0,12,0,0"/><TextBox Text="{Binding EndpointHost}" materialDesign:HintAssist.Hint="Endpoint 地址" Margin="0,8,0,0"/><TextBox Text="{Binding EndpointPort}" materialDesign:HintAssist.Hint="端口" Margin="0,8,0,0"/><TextBox Text="{Binding LocalAddresses[0]}" materialDesign:HintAssist.Hint="本地 CIDR" Margin="0,8,0,0"/><TextBox Text="{Binding AllowedIPs[0]}" materialDesign:HintAssist.Hint="Allowed IPs" Margin="0,8,0,0"/><TextBlock Text="私钥由 .conf 导入，不在界面中显示。" Style="{StaticResource HintText}" Margin="0,10,0,0"/></StackPanel></DataTemplate>
    </Window.Resources>

    <Grid Background="#090C09">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
        <Border Background="#101510" BorderBrush="#26352A" BorderThickness="0,0,0,1"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#1F7A45" CornerRadius="12" Width="46" Height="46"><materialDesign:PackIcon Kind="ShieldCheck" Width="28" Height="28" Foreground="#F3FAF4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="EasyXray" FontSize="24" FontWeight="Bold"/><TextBlock Text="轻量、无 Agent 的 Ubuntu 代理部署器" Foreground="#AAB8AA"/></StackPanel><Border Background="#14261A" CornerRadius="12" Padding="10,4" Margin="18,0,0,0"><TextBlock Text="推荐 REALITY" Foreground="#77D98A" FontWeight="SemiBold"/></Border></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="打开配置" Command="{Binding OpenCommand}" Margin="0,0,8,0"/><Button Content="保存配置" Command="{Binding SaveCommand}"/></StackPanel></Grid></Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding CurrentStep, Mode=TwoWay}" SelectionChanged="WorkflowStepChanged" Background="#090C09" BorderBrush="#3D5541" BorderThickness="0,0,0,1" Margin="24,14,24,0">
            <TabItem Header="  ① 服务器  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="8,22,8,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <materialDesign:Card Padding="26" Style="{StaticResource WideLeft}"><StackPanel><TextBlock Text="连接一台新服务器" Style="{StaticResource StepTitle}"/><TextBlock Text="只需填写 IP、SSH 用户和私钥。首次连接会获取 SSH 主机公钥指纹并固定，之后自动严格校验。" Style="{StaticResource HintText}" Margin="0,8,0,22"/><TextBox Text="{Binding ServerHost, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="服务器 IP 或主机名"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox Text="{Binding SshUser}" materialDesign:HintAssist.Hint="SSH 用户，例如 ubuntu"/><TextBox Grid.Column="2" Text="{Binding SshPort}" materialDesign:HintAssist.Hint="SSH 端口"/></Grid><DockPanel Margin="0,12,0,0"><Button Content="选择密钥" Command="{Binding BrowseKeyCommand}" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Text="{Binding PrivateKeyPath}" materialDesign:HintAssist.Hint="SSH 私钥文件 (.pem)"/></DockPanel><TextBox Text="{Binding HostFingerprint}" IsReadOnly="True" materialDesign:HintAssist.Hint="已固定的 SSH 主机公钥指纹（自动）" Margin="0,12,0,0"/><Expander Header="密码登录 / sudo / su（高级）" Margin="0,14,0,0"><StackPanel Margin="4,10,4,2"><PasswordBox PasswordChanged="SshPasswordChanged" materialDesign:HintAssist.Hint="SSH 密码"/><PasswordBox PasswordChanged="PrivateKeyPassphraseChanged" materialDesign:HintAssist.Hint="私钥口令" Margin="0,9,0,0"/><PasswordBox PasswordChanged="SudoPasswordChanged" materialDesign:HintAssist.Hint="sudo 密码" Margin="0,9,0,0"/><PasswordBox PasswordChanged="RootPasswordChanged" materialDesign:HintAssist.Hint="su 的 root 密码" Margin="0,9,0,0"/><TextBlock Text="四种凭据互相独立，只保存在本次运行内存中。" Style="{StaticResource HintText}" Margin="0,8,0,0"/></StackPanel></Expander><Button Content="检测服务器并继续" Command="{Binding NextFromServerCommand}" HorizontalAlignment="Right" Padding="24,10" Margin="0,20,0,0" Background="#1F7A45"/></StackPanel></materialDesign:Card>
                    <StackPanel Style="{StaticResource WideSecond}"><materialDesign:Card Padding="24" Background="#111A12"><StackPanel><materialDesign:PackIcon Kind="RocketLaunchOutline" Width="42" Height="42" Foreground="#78D98B"/><TextBlock Text="极速部署 REALITY" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="新机器最省心的选择：自动检测 Ubuntu 和提权方式、安装 Xray、生成全新 UUID / Short ID / 密钥，并以 Direct 出口部署 TCP/443。" Style="{StaticResource HintText}" Margin="0,10,0,18"/><Button Content="一键生成并部署" Command="{Binding OneClickRealityCommand}" Padding="24,12" Background="#1B6B3A"/></StackPanel></materialDesign:Card><materialDesign:Card Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="为什么推荐 REALITY？" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="不要求域名，不需要维护证书，TCP/443 外观自然，资源占用低。对于第一次使用代理服务器的人，它更不容易配置错。" Style="{StaticResource HintText}" Margin="0,8,0,0"/></StackPanel></materialDesign:Card></StackPanel>
                </Grid></ScrollViewer>
            </TabItem>

            <TabItem Header="  ② 入站  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="8,22,8,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="选择接入协议" Style="{StaticResource StepTitle}"/><TextBlock Text="可以同时添加多个入站。TCP 和 UDP 可以共享 443 端口。" Style="{StaticResource HintText}" Margin="0,8,0,18"/><materialDesign:Card Padding="18" Background="#15321D"><StackPanel><TextBlock Text="REALITY" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="推荐给所有新手" Foreground="#77D98A" Margin="0,4,0,0"/><TextBlock Text="TCP/443 · 无需域名" Style="{StaticResource HintText}" Margin="0,5,0,12"/><Button Content="添加 REALITY" Command="{Binding AddRealityInboundCommand}"/></StackPanel></materialDesign:Card><materialDesign:Card Padding="18" Margin="0,12,0,0" Background="#17140D"><StackPanel><TextBlock Text="Hysteria2" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="进阶用户" Foreground="#D5A83E" Margin="0,4,0,0"/><TextBlock Text="UDP/443 · 必须有域名" Style="{StaticResource HintText}" Margin="0,5,0,12"/><Button Content="添加 Hysteria2" Command="{Binding AddHysteriaInboundCommand}" Background="#806B2E"/></StackPanel></materialDesign:Card><ListBox ItemsSource="{Binding Inbounds}" SelectedItem="{Binding SelectedInbound}" DisplayMemberPath="Name" Margin="0,18,0,0" MinHeight="110"/></StackPanel>
                    <materialDesign:Card Grid.Column="2" Padding="0"><ContentControl Content="{Binding SelectedInbound}"/></materialDesign:Card>
                    <StackPanel Grid.Column="4"><materialDesign:Card Padding="20"><StackPanel><TextBlock Text="随机安全参数" Style="{StaticResource SectionLabel}"/><Button Content="重新生成 UUID / 密码 / Short ID" Command="{Binding GenerateRandomCommand}" Margin="0,12,0,0"/><Button Content="在服务器生成 REALITY 密钥" Command="{Binding GenerateRealityKeysCommand}" Margin="0,8,0,0"/><TextBlock Text="每次部署都可使用全新的随机身份参数。私钥不会显示在界面。" Style="{StaticResource HintText}" Margin="0,10,0,0"/></StackPanel></materialDesign:Card><materialDesign:Card Padding="20" Margin="0,14,0,0" Background="#17140D"><StackPanel><TextBlock Text="HY2 可信证书" Style="{StaticResource SectionLabel}" Foreground="#D5A83E"/><TextBox Text="{Binding CertificateDomain, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="必须解析到本机的域名" Margin="0,12,0,0"/><TextBox Text="{Binding CertificateEmail}" materialDesign:HintAssist.Hint="Let's Encrypt 联系邮箱" Margin="0,9,0,0"/><Button Content="用 Certbot 申请 / 续期" Command="{Binding IssueCertificateCommand}" Margin="0,12,0,0" Background="#806B2E"/><TextBlock Text="部署 HY2 时若证书不存在会自动安装 Certbot 并申请。端口 80 必须能从公网访问。" Style="{StaticResource HintText}" Margin="0,9,0,0"/></StackPanel></materialDesign:Card><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="上一步" Command="{Binding PreviousStepCommand}" Margin="0,0,8,0"/><Button Content="下一步：出口" Command="{Binding NextStepCommand}" Background="#1F7A45"/></StackPanel></StackPanel>
                </Grid></ScrollViewer>
            </TabItem>

            <TabItem Header="  ③ 出口与部署  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="8,22,8,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="选择出口" Style="{StaticResource StepTitle}"/><TextBlock Text="不添加、不选择下一跳时默认 Direct，适合绝大多数用户。" Style="{StaticResource HintText}" Margin="0,8,0,18"/><Border Background="#14261A" CornerRadius="8" Padding="14"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Earth" Foreground="#77D98A"/><TextBlock Text="  Direct（默认直连）" FontWeight="SemiBold"/></StackPanel></Border><TextBlock Text="可选链式出口" Style="{StaticResource SectionLabel}" Margin="0,20,0,8"/><Button Content="添加 REALITY 下一跳" Command="{Binding AddRealityOutboundCommand}" Margin="0,4"/><Button Content="添加 Hysteria2 下一跳" Command="{Binding AddHysteriaOutboundCommand}" Margin="0,4" Background="#806B2E"/><Button Content="导入 WireGuard .conf" Command="{Binding ImportWireGuardCommand}" Margin="0,4"/><ListBox ItemsSource="{Binding Outbounds}" SelectedItem="{Binding SelectedOutbound}" DisplayMemberPath="Name" MinHeight="90" Margin="0,12,0,0"/></StackPanel>
                    <materialDesign:Card Grid.Column="2" Padding="16"><StackPanel><TextBlock Text="下一跳参数" Style="{StaticResource SectionLabel}"/><ContentControl Content="{Binding SelectedOutbound}"/><Separator Margin="0,14"/><TextBlock Text="当前入站的主出口" Style="{StaticResource SectionLabel}"/><ComboBox ItemsSource="{Binding Inbounds}" SelectedItem="{Binding SelectedInbound}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="选择入站" Margin="0,12,0,0"/><ComboBox ItemsSource="{Binding ExitChoices}" SelectedItem="{Binding SelectedExit}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Direct 或一个下一跳" Margin="0,10,0,0"/><Button Content="应用出口" Command="{Binding ApplyExitCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"/></StackPanel></materialDesign:Card>
                    <StackPanel Grid.Column="4">
                        <materialDesign:Card Padding="22" Background="#111A12"><StackPanel><materialDesign:PackIcon Kind="ServerSecurity" Width="38" Height="38" Foreground="#78D98B"/><TextBlock Text="准备部署" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="会自动安装缺失的 Xray，补齐 REALITY 密钥、HY2 证书，验证配置；变更失败时恢复上一份配置。" Style="{StaticResource HintText}" Margin="0,9,0,12"/><Button Content="检查 Xray 服务状态" Command="{Binding CheckXrayStatusCommand}"/><TextBlock Text="{Binding XrayServiceStatus}" Style="{StaticResource HintText}" Margin="0,10,0,0"/><Button Content="检查并部署到 Ubuntu" Command="{Binding DeployCommand}" Padding="20,12" Background="#1F7A45" Margin="0,14,0,0"/></StackPanel></materialDesign:Card>
                        <materialDesign:Card Padding="18" Margin="0,14,0,0" Visibility="{Binding HasClientLinks, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="复制 VLESS" Command="{Binding CopyVlessLinksCommand}" Margin="0,0,6,0"/><Button Content="复制 HY2" Command="{Binding CopyHysteria2LinksCommand}" Margin="0,0,6,0"/><Button Content="复制全部" Command="{Binding CopyAllLinksCommand}"/></StackPanel><TextBlock Text="客户端链接与二维码" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/></DockPanel>
                                <ItemsControl ItemsSource="{Binding ClientLinks}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#344336" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Protocol}" Foreground="#78D98B" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,3,0,8"/>
                                                    <Border Background="White" Padding="8" HorizontalAlignment="Center"><Image Source="{Binding QrCode}" Width="180" Height="180" Stretch="Uniform"/></Border>
                                                    <TextBox Text="{Binding Link}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="90" Margin="0,10,0,0"/>
                                                    <Button Content="复制链接" Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="隐私选项" Style="{StaticResource SectionLabel}"/><Button Content="添加常用 STUN / WebRTC UDP 阻断" Command="{Binding AddStunPresetCommand}" Margin="0,10,0,0"/><TextBlock Text="仅阻断经过本代理路径的流量，不代表能阻断设备直接发出的 WebRTC。" Style="{StaticResource HintText}" Margin="0,8,0,0"/></StackPanel></materialDesign:Card>
                        <Button Content="返回修改入站" Command="{Binding PreviousStepCommand}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#101510" BorderBrush="#26352A" BorderThickness="0,1,0,0"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="InformationOutline" Foreground="{Binding StatusForeground}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusForeground}" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"/><ProgressBar Grid.Column="2" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Width="130" Height="5" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
</Window>
