<Application x:Class="EasyXray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EasyXray"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Green" SecondaryColor="Amber" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#F4FAF5" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4FAF5" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#EAF5EC" />
                <Setter Property="Background" Value="#111712" />
                <Setter Property="BorderBrush" Value="#3D5541" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#F4FAF5" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="#F4FAF5" />
                <Setter Property="Background" Value="#101510" />
                <Setter Property="BorderBrush" Value="#3D5541" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Margin="3,0" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1D5C35" />
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#82E39A" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#173A23" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="10,7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
